# Copy this file to frontend/.env and fill in your values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# Pinata API key JWT — used to pin card images and metadata to IPFS.
# Create one at https://app.pinata.cloud/developers/api-keys
# Note: this JWT ships in the client bundle, so use a key with the narrowest scope.
VITE_PINATA_JWT=your_pinata_jwt

# IPFS gateway used to convert ipfs:// URIs into fetchable https:// URLs.
VITE_PINATA_GATEWAY=gateway.pinata.cloud
