# Frontend (browser-side) IPFS uploads via Pinata.
# The mint page uploads card art + metadata directly from the browser, so the
# JWT is embedded in the client bundle — use a Pinata JWT scoped for your app
# and never a key with wider access than you need.
#
# Get a JWT: https://app.pinata.cloud/developers/api-keys
VITE_PINATA_JWT=

# Public gateway used to fetch IPFS content (e.g. gateway.pinata.cloud or ipfs.io).
VITE_PINATA_GATEWAY=gateway.pinata.cloud