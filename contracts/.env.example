# Copy this file to contracts/.env and fill in your values.

# Sepolia RPC endpoint (e.g. Alchemy/Infura project URL).
SEPOLIA_RPC_URL=https://sepolia.example-rpc.io/v3/YOUR_PROJECT_ID
# Deployer account private key (hex, with 0x prefix). Never commit the real one.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HEX
# Etherscan API key for contract verification.
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# Address that receives the marketplace fee.
FEE_RECIPIENT=0xYOUR_FEE_RECIPIENT_ADDRESS

# Pinata credentials used by the seed-metadata upload script.
PINATA_JWT=your_pinata_jwt
PINATA_GATEWAY=gateway.pinata.cloud
